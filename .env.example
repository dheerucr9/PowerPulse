HOST_BIND_IP=127.0.0.1

# Backend runtime settings
DATABASE_DSN=postgresql+psycopg://solar:solar@db:5432/solar
GATEWAY_IP=CHANGE_ME_IP
# SunPower/SunStrong local PVS gateway credentials.
# These are not the PowerPulse, Grafana, database, router, or cloud app credentials.
GATEWAY_USER=CHANGE_ME_GATEWAY_USER
GATEWAY_PASS=CHANGE_ME_GATEWAY_PASSWORD
POLL_SECONDS=60
INTELLIGENCE_SECONDS=300
# Transitional local-test compatibility only (runtime target is Postgres)
DB_PATH=/data/solar.db
GATEWAY_TIMEOUT=20
LATITUDE=CHANGE_ME_LAT
LONGITUDE=CHANGE_ME_LONG
SUN_BUFFER_MINUTES=25
TZ=CHANGE_ME_TZ
FRONTEND_API_ORIGIN=http://127.0.0.1:8000

# Metrics and backup settings
ENABLE_METRICS=1
METRICS_ENABLED=1
WORKER_METRICS_ENABLED=1
WORKER_METRICS_PORT=9101
BACKUP_DIR=/backups
BACKUP_FILE=/backups/solar-backup.sql
BACKUP_RETENTION_DAYS=7

# DB and observability services
POSTGRES_DB=solar
POSTGRES_USER=solar
POSTGRES_PASSWORD=solar
POSTGRES_HOST=db
POSTGRES_PORT=5432
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tesla Wall Connector (EV charging)
WALL_CONNECTOR_IP=CHANGE_ME_IP
WALL_CONNECTOR_POLL_SECONDS=60
